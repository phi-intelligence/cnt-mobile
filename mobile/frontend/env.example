# ============================================
# CNT Mobile App Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# ENVIRONMENT (REQUIRED)
# ============================================
# Options: development | production
ENVIRONMENT=production

# ============================================
# PRODUCTION URLs (REQUIRED for production)
# ============================================
# Backend API URL (with /api/v1 suffix)
API_BASE_URL=https://api.christnewtabernacle.com/api/v1

# WebSocket URL for real-time features
WEBSOCKET_URL=wss://api.christnewtabernacle.com

# Media CDN URL (CloudFront)
MEDIA_BASE_URL=https://d126sja5o8ue54.cloudfront.net

# LiveKit URLs for meetings and voice
LIVEKIT_WS_URL=wss://livekit.christnewtabernacle.com
LIVEKIT_HTTP_URL=https://livekit.christnewtabernacle.com

# ============================================
# DEVELOPMENT (these are auto-detected)
# ============================================
# For development, just set ENVIRONMENT=development
# URLs will automatically use:
#   - API: http://localhost:8002/api/v1 (or 10.0.2.2 on Android emulator)
#   - WebSocket: ws://localhost:8002
#   - Media: http://localhost:8002
#   - LiveKit: ws://localhost:7880
#
# To override development URLs, uncomment and modify:
# API_BASE_URL=http://192.168.1.100:8002/api/v1
# WEBSOCKET_URL=ws://192.168.1.100:8002
# MEDIA_BASE_URL=http://192.168.1.100:8002
# LIVEKIT_WS_URL=ws://192.168.1.100:7880
# LIVEKIT_HTTP_URL=http://192.168.1.100:7880

# ============================================
# Platform Subscriptions (Paystack)
# ============================================
# Paystack secrets stay on the backend only. The mobile app:
#   1. Calls POST /api/v1/subscriptions/initialize
#   2. Opens authorization_url in an in-app WebView
#   3. Intercepts navigation to any URL containing /subscription/callback
#   4. Verifies via GET /api/v1/subscriptions/verify/{reference}
#
# Backend should set PAYSTACK_CALLBACK_URL to a URL whose path includes
# /subscription/callback (e.g. http://localhost:8080/subscription/callback).
# The WebView does not need that host to load the web app — it only detects
# the path and closes with the payment reference.
#
# No Paystack secret or public key is required in this mobile .env.
